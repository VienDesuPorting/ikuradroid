<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): full-bleed portrait art lives on
     the background layer and is cropped by the launcher mask, so the
     face stays inside the safe zone on every mask shape. The salmon-roe
     silhouette (icon_foreground.xml) remains as the themed (monochrome)
     icon for Android 13+. Legacy PNG fallbacks (drawable-mdpi ..
     drawable-xxxhdpi icon.png) are regenerated from the same art for
     Android 7.x and older. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/icon_background"/>
    <foreground android:drawable="@android:color/transparent"/>
    <!-- Themed icons (Android 13+): silhouette of the roe cluster -->
    <monochrome android:drawable="@drawable/icon_foreground"/>
</adaptive-icon>
