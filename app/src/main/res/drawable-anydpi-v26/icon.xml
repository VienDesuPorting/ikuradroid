<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The legacy PNG fallbacks
     (drawable-ldpi .. drawable-xhdpi icon.png) are regenerated in the
     same "ikura" style for Android 5.x-7.x. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/icon_foreground"/>
    <!-- Themed icons (Android 13+): silhouette of the roe cluster -->
    <monochrome android:drawable="@drawable/icon_foreground"/>
</adaptive-icon>
