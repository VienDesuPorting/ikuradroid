<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_context">

    <!-- JoiPlay-style manual title; the folder name stays untouched -->
    <LinearLayout
        android:id="@+id/ctx_rename_row"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ctx_rename"
            app:tint="?attr/colorOnSurfaceVariant"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/ctx_rename"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"/>

    </LinearLayout>

    <!-- Fetches a VNDB cover for the tile; the search term is the
         display title (rename or SUF name), one hit downloads silently,
         several open the pick dialog -->
    <LinearLayout
        android:id="@+id/ctx_cover_row"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ctx_cover"
            app:tint="?attr/colorOnSurfaceVariant"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/ctx_cover"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"/>

    </LinearLayout>

    <!-- Drops the cached cover (file + metadata); shown only for tiles
         that have one - mostly to undo a wrong automatic match -->
    <LinearLayout
        android:id="@+id/ctx_cover_remove_row"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ctx_cover"
            app:tint="?attr/colorOnSurfaceVariant"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/ctx_cover_remove"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"/>

    </LinearLayout>

    <!-- Files stay on the storage; re-adding the folder restores the title -->
    <LinearLayout
        android:id="@+id/ctx_hide_row"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ctx_hide"
            app:tint="?attr/colorOnSurfaceVariant"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/ctx_hide"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"/>

    </LinearLayout>

    <!-- Destructive: wipes the game folder(s) after a confirmation -->
    <LinearLayout
        android:id="@+id/ctx_delete_row"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ctx_delete"
            app:tint="?attr/colorOnSurfaceVariant"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/ctx_delete"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"/>

    </LinearLayout>

</LinearLayout>
