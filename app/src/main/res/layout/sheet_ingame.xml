<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.0: content view of the in-game menu bottom sheet (SDLActivity).
     Rows are added programmatically from sheet_ingame_item.xml; the
     sheet supplies its own M3 rounded corners and scrim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/ingame_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="@string/ingame_menu"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/ingame_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp" />

</LinearLayout>
