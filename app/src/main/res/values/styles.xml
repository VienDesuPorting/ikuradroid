<resources>

    <!--
        Material 3, NoActionBar (1.2.0): every screen now supplies its own
        MaterialToolbar, edge-to-edge insets are handled in code, and the
        2011 folder-browser attrs (folderUpImage, fileImage, ...) are gone
        together with the browser itself - replaced by the system SAF
        picker. DayNight gives automatic dark mode; DynamicColors (see
        IkuraApplication) adds Material You wallpaper palettes on 12+.
    -->
    <style name="AppBaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand seed: warm "ikura" (salmon roe) orange. Used on Android <12;
             on 12+ the wallpaper palette takes over. -->
        <item name="colorPrimary">@color/ikura_primary</item>
        <item name="colorOnPrimary">@color/ikura_on_primary</item>
        <item name="colorPrimaryContainer">@color/ikura_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ikura_on_primary_container</item>
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme"/>

    <!-- 1.3.0: the in-game (SDL) screen. M3 descendant so the in-game
         bottom sheet matches the rest of the app; the opaque black
         window background replaces the 2016 Theme.NoTitleBar.Fullscreen
         (black screen while the engine boots, status bar hidden below
         Android 15 where edge-to-edge is enforced anyway). -->
    <style name="SDLTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
