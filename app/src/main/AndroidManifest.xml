<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <application android:name=".IkuraApplication"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <activity android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboardHidden|orientation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1.2.0: the About screen (was a dialog until 1.1.0) -->
        <activity android:name=".AboutActivity"
            android:label="@string/menu_about"
            android:parentActivityName=".MainActivity"
            android:exported="false">
        </activity>

        <!-- 1.2.0: engines and supported titles -->
        <activity android:name=".EnginesActivity"
            android:label="@string/menu_engines"
            android:parentActivityName=".MainActivity"
            android:exported="false">
        </activity>

        <activity android:name="org.libsdl.app.SDLActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize">
        </activity>

    </application>

    <!-- OpenGL ES 2.0 -->
    <uses-feature android:glEsVersion="0x00020000" />

    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- 1.2.0: all storage permissions are gone. Games are read through
         the persisted SAF tree grant (system folder picker) and copied
         into the app-private area, which needs no permission at all;
         savegames live in getExternalFilesDir() - also permission-free. -->
</manifest>
