<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <application android:name=".IkuraApplication"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <activity android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboardHidden|orientation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1.2.0: the About screen (was a dialog until 1.1.0) -->
        <activity android:name=".AboutActivity"
            android:label="@string/menu_about"
            android:parentActivityName=".MainActivity"
            android:exported="false">
        </activity>

        <!-- 1.2.0: engines and supported titles -->
        <activity android:name=".EnginesActivity"
            android:label="@string/menu_engines"
            android:parentActivityName=".MainActivity"
            android:exported="false">
        </activity>

        <!-- 1.3.0: M3 fullscreen theme (was Theme.NoTitleBar.Fullscreen)
             so the in-game bottom sheet matches the app. -->
        <activity android:name="org.libsdl.app.SDLActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/SDLTheme"
            android:configChanges="orientation|keyboardHidden|screenSize">
        </activity>

    </application>

    <!-- OpenGL ES 2.0 -->
    <uses-feature android:glEsVersion="0x00020000" />

    <!-- 1.3.0: even WAKE_LOCK is gone - the game screen stays on via the
         window flag FLAG_KEEP_SCREEN_ON, which needs no permission.
         1.2.0 removed all storage permissions (SAF). The app now requests
         no permissions at all. -->
</manifest>
